# Copy to .env and adjust. All variables use the MEDRAG_ prefix.
# Never commit .env or any real credentials / patient data.

MEDRAG_APP_NAME=Medical Record RAG API
MEDRAG_ENVIRONMENT=development      # development | testing | production
MEDRAG_DEBUG=false

MEDRAG_HOST=127.0.0.1
MEDRAG_PORT=8000

MEDRAG_LOG_LEVEL=INFO               # CRITICAL | ERROR | WARNING | INFO | DEBUG
# Leave blank for console-only logging; set a path for a rotating log file.
MEDRAG_LOG_FILE=

MEDRAG_DATA_DIR=data

# --- Document ingestion (Milestone 2) ---
MEDRAG_INGESTION_MAX_FILE_MB=25
MEDRAG_INGESTION_MAX_PDF_PAGES=200
# PDF pages with fewer alphanumeric characters than this (and containing images) are OCR'd.
MEDRAG_PDF_MIN_TEXT_CHARS=30

# Tesseract OCR. Blank = search PATH, then the default Windows install folders.
# Example: MEDRAG_TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
MEDRAG_TESSERACT_CMD=
MEDRAG_OCR_LANGUAGES=eng            # e.g. eng+hin (needs the Hindi language pack installed)
MEDRAG_OCR_DPI=300                  # render resolution for scanned PDF pages (72-600)
MEDRAG_OCR_PSM=6                    # Tesseract page segmentation mode (3-13)
MEDRAG_OCR_TIMEOUT_SECONDS=120
